<Project Sdk="Microsoft.NET.Sdk">

  <!-- Quartz.NET 3 and 4 share package and type names, so the Quartz 4 build is tested in its own assembly. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="Quartz" Version="4.6.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
    <Compile Include="..\RunSignal.Tests\MetricRecorder.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\RunSignal.Quartz4\RunSignal.Quartz4.csproj" />
  </ItemGroup>

</Project>
