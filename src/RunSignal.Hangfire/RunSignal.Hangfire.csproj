<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>RunSignal.Hangfire</RootNamespace>
    <PackageId>RunSignal.Hangfire</PackageId>
    <Title>RunSignal.Hangfire: monitor Hangfire jobs with RunSignal and OpenTelemetry</Title>
    <Description>Records every Hangfire job run as a RunSignal workload run (success, failure, cancellation and duration) with no code in your jobs. Recurring jobs are named after their ID and their cron schedule is picked up for missed-run alerts.</Description>
    <PackageTags>$(PackageTags);hangfire-monitoring;recurring-jobs</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Hangfire.Core" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunSignal.DotNet\RunSignal.DotNet.csproj" />
  </ItemGroup>

</Project>
