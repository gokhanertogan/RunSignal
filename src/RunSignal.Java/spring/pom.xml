<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>io.github.gokhanertogan.runsignal</groupId>
    <artifactId>runsignal-parent</artifactId>
    <version>0.2.0</version>
  </parent>

  <artifactId>runsignal-spring-boot-starter</artifactId>
  <name>RunSignal Spring Boot starter</name>
  <description>Records every Spring @Scheduled method run as a RunSignal workload run, registers @Scheduled cron jobs before they first fire, and writes the workload manifest, with no code in your jobs.</description>

  <dependencies>
    <dependency>
      <groupId>io.github.gokhanertogan.runsignal</groupId>
      <artifactId>runsignal</artifactId>
      <version>${project.version}</version>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-autoconfigure</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.springframework</groupId>
      <artifactId>spring-context</artifactId>
      <optional>true</optional>
    </dependency>

    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>io.opentelemetry</groupId>
      <artifactId>opentelemetry-sdk-testing</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-batch</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <!-- Spring Batch 6 (Spring Boot 4) moved its types to new packages, so each major version has its own test
       sources. The listener itself works with both by reflection. Run the Batch 5 tests with -Dbatch=5. -->
  <properties>
    <batch.tests>src/test-batch6/java</batch.tests>
  </properties>

  <profiles>
    <profile>
      <id>batch5</id>
      <activation>
        <property>
          <name>batch</name>
          <value>5</value>
        </property>
      </activation>
      <properties>
        <batch.tests>src/test-batch5/java</batch.tests>
      </properties>
    </profile>
  </profiles>

  <build>
    <plugins>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>build-helper-maven-plugin</artifactId>
        <version>3.6.0</version>
        <executions>
          <execution>
            <id>batch-tests</id>
            <phase>generate-test-sources</phase>
            <goals>
              <goal>add-test-source</goal>
            </goals>
            <configuration>
              <sources>
                <source>${batch.tests}</source>
              </sources>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
