{
  "name": "@runsignal/node",
  "version": "0.2.0",
  "description": "Cron job and background job monitoring for Node.js with OpenTelemetry: alert when a scheduled job is missed, fails, overruns or stalls, or a BullMQ queue stops processing. Works with node-cron, croner, cron, node-schedule and BullMQ; alerts for New Relic, Prometheus and Grafana.",
  "license": "MIT",
  "author": "Gokhan Ertogan",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gokhanertogan/RunSignal.git",
    "directory": "src/RunSignal.Node"
  },
  "keywords": [
    "cron-monitoring",
    "cron",
    "job-monitoring",
    "background-jobs",
    "scheduled-jobs",
    "heartbeat",
    "dead-mans-switch",
    "healthcheck",
    "bullmq",
    "node-cron",
    "croner",
    "node-schedule",
    "queue-monitoring",
    "worker",
    "opentelemetry",
    "otel",
    "observability",
    "monitoring",
    "alerting",
    "prometheus",
    "grafana",
    "newrelic",
    "typescript"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./bullmq": {
      "types": "./dist/bullmq.d.ts",
      "default": "./dist/bullmq.js"
    },
    "./cron": {
      "types": "./dist/cron.d.ts",
      "default": "./dist/cron.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 'dist-test/test/**/*.test.js'",
    "bench": "tsc -p tsconfig.test.json && node dist-test/test/bench.js",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "bullmq": ">=5.16.0"
  },
  "peerDependenciesMeta": {
    "bullmq": {
      "optional": true
    }
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/context-async-hooks": "^2.12.0",
    "@opentelemetry/sdk-metrics": "^2.12.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@types/node": "^26.6.5",
    "bullmq": "^6.4.0",
    "ioredis": "^6.0.0",
    "typescript": "^7.0.2"
  },
  "homepage": "https://github.com/gokhanertogan/RunSignal/tree/main/src/RunSignal.Node#readme",
  "bugs": {
    "url": "https://github.com/gokhanertogan/RunSignal/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "sideEffects": false
}
