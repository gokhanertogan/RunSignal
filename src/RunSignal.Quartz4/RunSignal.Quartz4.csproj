<Project Sdk="Microsoft.NET.Sdk">

  <!-- The same sources as RunSignal.Quartz, built against Quartz.NET 4, whose job and listener interfaces return
       ValueTask and which supports only .NET 10. The namespace is the same, so moving from Quartz 3 to 4 only
       changes the package. -->
  <PropertyGroup>
    <RootNamespace>RunSignal.Quartz</RootNamespace>
    <AssemblyName>RunSignal.Quartz4</AssemblyName>
    <TargetFramework>net10.0</TargetFramework>
    <DefineConstants>$(DefineConstants);QUARTZ4</DefineConstants>
    <PackageId>RunSignal.Quartz4</PackageId>
    <Title>RunSignal.Quartz4: monitor Quartz.NET 4 jobs with RunSignal and OpenTelemetry</Title>
    <Description>Records every Quartz.NET 4 job execution as a RunSignal workload run (success, failure, cancellation and duration) with no code in your jobs. Cron trigger schedules are picked up for missed-run alerts. For Quartz.NET 3, use RunSignal.Quartz.</Description>
    <PackageTags>$(PackageTags);quartz-monitoring;scheduler</PackageTags>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\RunSignal.Quartz\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Quartz" Version="4.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\RunSignal.DotNet\RunSignal.DotNet.csproj" />
  </ItemGroup>

</Project>
