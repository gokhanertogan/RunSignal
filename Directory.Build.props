<Project>

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>

    <Version>0.1.0</Version>
    <Authors>Gokhan Ertogan</Authors>
    <Copyright>Copyright (c) 2026 Gokhan Ertogan</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/gokhanertogan/RunSignal</PackageProjectUrl>
    <RepositoryUrl>https://github.com/gokhanertogan/RunSignal</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>observability;opentelemetry;monitoring;alerting;background-jobs;cron;heartbeat;hangfire;quartz;newrelic;workload</PackageTags>

    <!-- Source Link: lets consumers step into this code from the debugger. -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <!-- Settings for the shipped libraries under src/. -->
  <PropertyGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <TargetFramework>net8.0</TargetFramework>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup Condition="$(MSBuildProjectDirectory.Contains('$([System.IO.Path]::DirectorySeparatorChar)src$([System.IO.Path]::DirectorySeparatorChar)'))">
    <!-- nuget.org shows the package README without the repository around it, so packages carry the .NET guide,
         whose links are absolute. -->
    <None Include="$(MSBuildThisFileDirectory)docs/dotnet.md" Pack="true" PackagePath="\README.md" />
  </ItemGroup>

</Project>
